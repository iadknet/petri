{
  "name": "petri-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "tsx e2e/run.ts",
    "test:e2e:headed": "tsx e2e/run.ts --headed",
    "test:e2e:scenario": "tsx e2e/run.ts --scenario"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@tanstack/react-query": "^5.0.0",
    "@xyflow/react": "^12.10.1",
    "elkjs": "^0.11.1",
    "lightweight-charts": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@fontsource-variable/jetbrains-mono": "^5.0.0",
    "@fontsource/geist-sans": "^5.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
