    {
      "id": 26,
      "type": "timeseries",
      "title": "Barrier bumps next to a barrier, by barrier reader",
      "description": "Of the moves a creature made while standing next to a barrier, the share that walked into the barrier. Split by whether the creature's brain has a reachable node reading the barrier input (presence, not use). If creatures that can sense barriers bump as often as creatures that cannot, the sensor is not shaping their movement.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 58,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum by (petri_reader_state) (rate(petri_run_move_blocked_barrier_with_barrier_neighbor_by_reader_state_total{petri_run_id=\"$run_id\"}[1m])) or 0 * sum by (petri_reader_state) (rate(petri_run_move_attempts_with_barrier_neighbor_by_reader_state_total{petri_run_id=\"$run_id\"}[1m]))) / sum by (petri_reader_state) (rate(petri_run_move_attempts_with_barrier_neighbor_by_reader_state_total{petri_run_id=\"$run_id\"}[1m]))",
          "legendFormat": "{{petri_reader_state}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "interval": "1s",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "auto",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
