{
  "annotations": {
    "list": []
  },
  "editable": false,
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Selected runs",
      "description": "Identity of each selected run from its run.started record: when it started, which binary, seed, world, preset, build revision and full-config digest. Runs with the same build and config digest differ only by seed.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "range",
          "expr": "{service_name=~\"v3-cli|v3-server|v3-lab\"} | event_name=\"run.started\" | petri_run_id=~\"$runs\""
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "keepTime": false
          }
        },
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "Time": true,
              "service_name": true,
              "petri_run_id": true,
              "petri_seed": true,
              "petri_world": true,
              "petri_preset": true,
              "petri_recipe": true,
              "petri_build_revision": true,
              "petri_config_digest": true
            },
            "indexByName": {
              "Time": 0,
              "service_name": 1,
              "petri_run_id": 2,
              "petri_seed": 3,
              "petri_world": 4,
              "petri_preset": 5,
              "petri_recipe": 6,
              "petri_build_revision": 7,
              "petri_config_digest": 8
            },
            "renameByName": {}
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "petri_run_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open run",
                    "url": "/d/petri-run?var-run_id=${__value.raw}&${__url_time_range}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Time",
            "desc": true
          }
        ]
      }
    },
    {
      "id": 2,
      "type": "row",
      "title": "Against ticks",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 3,
      "type": "trend",
      "title": "Population by tick (sampled)",
      "description": "Living creatures at sampled ticks. One line per selected run, labelled by the first eight characters of its run ID. Points are sampled at a step of the time range divided by 5,000: narrow the range to the runs for finer detail.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (run) (label_replace(petri_run_tick{petri_run_id=~\"$runs\"}, \"run\", \"$1\", \"petri_run_id\", \"(.{8}).*\"))",
          "legendFormat": "",
          "range": true,
          "instant": false,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (run) (label_replace(petri_tick_population{petri_run_id=~\"$runs\"}, \"run\", \"$1\", \"petri_run_id\", \"(.{8}).*\"))",
          "legendFormat": "",
          "range": true,
          "instant": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Value #A": "tick",
              "Value #B": "population"
            }
          }
        },
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "run",
            "rowField": "tick",
            "valueField": "population",
            "emptyValue": "null"
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^tick\\\\run$",
            "renamePattern": "tick"
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "tick",
                "destinationType": "number"
              }
            ],
            "fields": {}
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "tick"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "auto",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "interval": "1s",
      "maxDataPoints": 5000,
      "options": {
        "xField": "tick",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
