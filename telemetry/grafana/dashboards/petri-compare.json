    {
      "id": 10,
      "type": "barchart",
      "title": "Barrier bumps next to a barrier, by barrier reader",
      "description": "Of the moves a creature made while standing next to a barrier, the share that walked into the barrier. Split by whether the creature's brain has a reachable node reading the barrier input (presence, not use). If creatures that can sense barriers bump as often as creatures that cannot, the sensor is not shaping their movement. One group of bars per selected run, labelled by the first eight characters of its run ID; totals over the whole time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum by (run, petri_reader_state) (label_replace(last_over_time(petri_run_move_blocked_barrier_with_barrier_neighbor_by_reader_state_total{petri_run_id=~\"$runs\"}[$__range]), \"run\", \"$1\", \"petri_run_id\", \"(.{8}).*\")) or 0 * sum by (run, petri_reader_state) (label_replace(last_over_time(petri_run_move_attempts_with_barrier_neighbor_by_reader_state_total{petri_run_id=~\"$runs\"}[$__range]), \"run\", \"$1\", \"petri_run_id\", \"(.{8}).*\"))) / sum by (run, petri_reader_state) (label_replace(last_over_time(petri_run_move_attempts_with_barrier_neighbor_by_reader_state_total{petri_run_id=~\"$runs\"}[$__range]), \"run\", \"$1\", \"petri_run_id\", \"(.{8}).*\"))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "petri_reader_state",
            "rowField": "run",
            "valueField": "Value",
            "emptyValue": "null"
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "run\\petri_reader_state": "run"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1
          },
          "min": 0,
          "max": 1
