{
  "uid": "petri-runs",
  "title": "Petri / Runs",
  "tags": [
    "petri"
  ],
  "editable": false,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timezone": "utc",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Runs started",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=~\"v3-cli|v3-server|v3-lab\"} | event_name=\"run.started\"",
          "queryType": "range"
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "keepTime": false
          }
        },
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "Time": true,
              "service_name": true,
              "petri_run_id": true,
              "petri_seed": true,
              "petri_world": true,
              "petri_recipe": true,
              "petri_build_revision": true,
              "petri_ticks_requested": true,
              "petri_metrics_interval_ms": true
            },
            "indexByName": {
              "Time": 0,
              "service_name": 1,
              "petri_run_id": 2,
              "petri_seed": 3,
              "petri_world": 4,
              "petri_recipe": 5,
              "petri_build_revision": 6,
              "petri_ticks_requested": 7,
              "petri_metrics_interval_ms": 8
            },
            "renameByName": {}
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "petri_run_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open run",
                    "url": "/d/petri-run?var-run_id=${__value.raw}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Time",
            "desc": true
          }
        ]
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Runs ended",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=~\"v3-cli|v3-server|v3-lab\"} | event_name=\"run.ended\"",
          "queryType": "range"
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "keepTime": false
          }
        },
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "Time": true,
              "petri_run_id": true,
              "petri_status": true,
              "petri_tick": true,
              "petri_wall_seconds": true
            },
            "indexByName": {
              "Time": 0,
              "petri_run_id": 1,
              "petri_status": 2,
              "petri_tick": 3,
              "petri_wall_seconds": 4
            },
            "renameByName": {}
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "petri_run_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open run",
                    "url": "/d/petri-run?var-run_id=${__value.raw}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Time",
            "desc": true
          }
        ]
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "Runs with metrics in range",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (petri_run_id, service_name) (max_over_time(petri_run_tick[$__range]))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "last tick"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "petri_run_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open run",
                    "url": "/d/petri-run?var-run_id=${__value.raw}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    }
  ]
}
