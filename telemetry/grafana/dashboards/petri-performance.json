{
  "uid": "petri-performance",
  "title": "Petri / Performance",
  "tags": [
    "petri"
  ],
  "editable": false,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "utc",
  "templating": {
    "list": [
      {
        "name": "run_id",
        "label": "Run",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(petri_run_tick, petri_run_id)",
          "refId": "run_id"
        },
        "definition": "label_values(petri_run_tick, petri_run_id)",
        "refresh": 2,
        "sort": 0,
        "includeAll": false,
        "multi": false,
        "current": {},
        "options": [],
        "hide": 0
      },
      {
        "name": "runs",
        "label": "Runs to compare",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(petri_run_tick, petri_run_id)",
          "refId": "runs"
        },
        "definition": "label_values(petri_run_tick, petri_run_id)",
        "refresh": 2,
        "sort": 0,
        "includeAll": false,
        "multi": true,
        "current": {},
        "options": [],
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "One run",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Time per tick by phase",
      "description": "Wall-clock seconds each tick spends in each timed phase, stacked: world update (food growth, aging, energy decay, death removal), sensor assembly, cognition (brain compute, run in parallel), actions and reward learning. \"outside timed phases\" is the rest of the tick's wall time (queue shuffle, priority sort, telemetry, a server's pacing). Rates over one minute; empty while the run is paused.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (petri_phase) (rate(petri_run_phase_wall_clock_seconds_total{petri_run_id=\"$run_id\"}[1m])) / ignoring (petri_phase) group_left () (max(deriv(petri_run_tick{petri_run_id=\"$run_id\"}[1m])) > 0)",
          "legendFormat": "{{petri_phase}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(1 / (max(deriv(petri_run_tick{petri_run_id=\"$run_id\"}[1m])) > 0)) - sum(rate(petri_run_phase_wall_clock_seconds_total{petri_run_id=\"$run_id\"}[1m])) / (max(deriv(petri_run_tick{petri_run_id=\"$run_id\"}[1m])) > 0)",
          "legendFormat": "outside timed phases",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "interval": "1s",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 30,
            "showPoints": "auto",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Phase share of timed tick",
      "description": "Each timed phase's share of the time spent in timed phases. Rates over one minute.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (petri_phase) (rate(petri_run_phase_wall_clock_seconds_total{petri_run_id=\"$run_id\"}[1m])) / ignoring (petri_phase) group_left () sum(rate(petri_run_phase_wall_clock_seconds_total{petri_run_id=\"$run_id\"}[1m]))",
          "legendFormat": "{{petri_phase}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "interval": "1s",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 30,
            "showPoints": "auto",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Ticks per second",
      "description": "Simulation ticks completed per wall-clock second.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(deriv(petri_run_tick{petri_run_id=\"$run_id\"}[1m]))",
          "legendFormat": "ticks/s",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "interval": "1s",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "auto",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Brain compute per creature-tick",
      "description": "Cognition phase wall time divided by creature-ticks: the wall-clock cost of one creature's brain for one tick at the run's thread count. Population changes move total cognition time; this line moves only when brains get cheaper or dearer.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 10,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(petri_run_phase_wall_clock_seconds_total{petri_run_id=\"$run_id\", petri_phase=\"cognition\"}[1m])) / (sum(rate(petri_run_creature_ticks_total{petri_run_id=\"$run_id\"}[1m])) > 0)",
          "legendFormat": "cognition per creature-tick",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "interval": "1s",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "auto",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Population (sampled)",
      "description": "Living creatures at sampled ticks, for reading the phases above: sensor assembly, cognition and actions scale with population, world update mostly with world size.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 10,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(petri_tick_population{petri_run_id=\"$run_id\"})",
          "legendFormat": "population",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "interval": "1s",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "auto",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Mean time per tick by phase, time range",
      "description": "Each phase's cumulative seconds at the end of the time range divided by the last tick reached: the run's mean time per tick in that phase since it started.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (petri_phase) (last_over_time(petri_run_phase_wall_clock_seconds_total{petri_run_id=\"$run_id\"}[$__range])) / ignoring (petri_phase) group_left () (max(last_over_time(petri_run_tick{petri_run_id=\"$run_id\"}[$__range])) > 0)",
          "legendFormat": "{{petri_phase}}",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "color",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Phase spans of sampled ticks",
      "description": "One row per phase span in the run's sampled tick traces, with its duration: sort by duration to find the slowest phases. The span ID opens the tick's trace.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "tableType": "spans",
          "limit": 500,
          "query": "{ span.petri.run_id = \"$run_id\" && name =~ \"world_update|sensor_assembly|cognition|actions|reward_learning\" } | select(span.petri.tick)"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "traceService": true,
              "traceName": true,
              "petri.run_id": true
            },
            "renameByName": {
              "petri.tick": "tick"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Duration",
            "desc": true
          }
        ]
      }
    },
    {
      "id": 9,
      "type": "row",
      "title": "Compare runs",
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 10,
      "type": "barchart",
      "title": "Mean time per tick by phase, per run",
      "description": "Each selected run's mean seconds per tick in each phase over the time range (cumulative phase seconds divided by the last tick reached), stacked. One bar per run, labelled by the first eight characters of its run ID. Compare runs of the same world and seed on the same host.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (run, petri_phase) (label_replace(last_over_time(petri_run_phase_wall_clock_seconds_total{petri_run_id=~\"$runs\"}[$__range]), \"run\", \"$1\", \"petri_run_id\", \"(.{8}).*\")) / ignoring (petri_phase) group_left () (max by (run) (label_replace(last_over_time(petri_run_tick{petri_run_id=~\"$runs\"}[$__range]), \"run\", \"$1\", \"petri_run_id\", \"(.{8}).*\")) > 0)",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "petri_phase",
            "rowField": "run",
            "valueField": "Value",
            "emptyValue": "null"
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "run\\petri_phase": "run"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xField": "run",
        "stacking": "normal",
        "groupWidth": 0.8,
        "barWidth": 0.9,
        "showValue": "never",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    }
  ]
}
