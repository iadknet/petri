#!/bin/sh
set -eu

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH='' cd -- "$script_dir/.." && pwd)
test_root=$(mktemp -d "${TMPDIR:-/tmp}/petri-prd-check-test.XXXXXX")
trap 'rm -rf "$test_root"' EXIT HUP INT TERM

fail() {
  printf 'prd-check-test: %s\n' "$*" >&2
  exit 1
}

make_fixture() {
  fixture_name=$1
  fixture_dir=$test_root/$fixture_name
  mkdir -p "$fixture_dir"
  cp -R "$repo_root/docs" "$fixture_dir/docs"
  cp -R "$repo_root/scripts" "$fixture_dir/scripts"
}

rewrite_file() {
  rewrite_expression=$1
  rewrite_path=$2
  rewrite_tmp=$rewrite_path.tmp
  sed "$rewrite_expression" "$rewrite_path" >"$rewrite_tmp"
  mv "$rewrite_tmp" "$rewrite_path"
}

refresh_index() {
  (cd "$fixture_dir" && scripts/prd-index >/dev/null)
}

expect_check_failure() {
  expected_message=$1
  if (cd "$fixture_dir" && scripts/prd-check >prd-check.out 2>&1); then
    fail "$fixture_dir unexpectedly passed PRD validation"
  fi
  grep -F "$expected_message" "$fixture_dir/prd-check.out" >/dev/null || {
    sed -n '1,120p' "$fixture_dir/prd-check.out" >&2
    fail "$fixture_dir did not report expected error: $expected_message"
  }
}

make_fixture positive-lean
(cd "$fixture_dir" && scripts/prd-new lean-example behavior projection >/dev/null && scripts/prd-check >/dev/null)

make_fixture too-many-stages
if (cd "$fixture_dir" && scripts/prd-new too-large one two three >/dev/null 2>&1); then
  fail 'Lean PRD with more than two stages unexpectedly passed'
fi

make_fixture oversized-budget
(cd "$fixture_dir" && scripts/prd-new budget-example one >/dev/null)
master=$fixture_dir/docs/prds/active/budget-example/master-prd.md
rewrite_file 's/^- Affected-File Budget: 25$/- Affected-File Budget: 26/' "$master"
expect_check_failure 'Lean-mode Affected-File Budget exceeds 25'

make_fixture exceeded-active-budget
(cd "$fixture_dir" && scripts/prd-new scope-example one >/dev/null)
master=$fixture_dir/docs/prds/active/scope-example/master-prd.md
stage=$fixture_dir/docs/prds/active/scope-example/stage-01-one.md
rewrite_file 's/^- Status: Draft$/- Status: In Progress/' "$master"
rewrite_file 's/^- Review Status: DRAFT$/- Review Status: APPROVED/' "$master"
rewrite_file 's/^- Review Count: 0$/- Review Count: 1/' "$master"
rewrite_file 's/^- Actual Affected Files: Pending$/- Actual Affected Files: 30/' "$master"
rewrite_file 's/— `Draft`$/— `In Progress`/' "$master"
rewrite_file 's/^- Status: Draft$/- Status: In Progress/' "$stage"
refresh_index
expect_check_failure 'Actual Affected Files exceeds its declared budget'

make_fixture excessive-readiness-reviews
(cd "$fixture_dir" && scripts/prd-new review-example one >/dev/null)
master=$fixture_dir/docs/prds/active/review-example/master-prd.md
rewrite_file 's/^- Review Count: 0$/- Review Count: 2/' "$master"
expect_check_failure 'Review Count exceeds the Lean-mode maximum of 1'

make_fixture unauthorized-deep
(cd "$fixture_dir" && scripts/prd-new --deep deep-example one >/dev/null)
master=$fixture_dir/docs/prds/active/deep-example/master-prd.md
stage=$fixture_dir/docs/prds/active/deep-example/stage-01-one.md
rewrite_file 's/^- Status: Draft$/- Status: Ready/' "$master"
rewrite_file 's/^- Review Status: DRAFT$/- Review Status: APPROVED/' "$master"
rewrite_file 's/^- Review Count: 0$/- Review Count: 1/' "$master"
rewrite_file 's/— `Draft`$/— `Ready`/' "$master"
rewrite_file 's/^- Status: Draft$/- Status: Ready/' "$stage"
refresh_index
expect_check_failure 'Deep mode requires recorded user authorization before readiness'

make_complete_fixture() {
  make_fixture "$1"
  (cd "$fixture_dir" && scripts/prd-new evidence-example one >/dev/null)
  master=$fixture_dir/docs/prds/active/evidence-example/master-prd.md
  stage=$fixture_dir/docs/prds/active/evidence-example/stage-01-one.md
  rewrite_file 's/^- Status: Draft$/- Status: Complete/' "$master"
  rewrite_file 's/^- Review Status: DRAFT$/- Review Status: APPROVED/' "$master"
  rewrite_file 's/^- Review Count: 0$/- Review Count: 1/' "$master"
  rewrite_file 's/^- Actual Affected Files: Pending$/- Actual Affected Files: 1/' "$master"
  rewrite_file 's/— `Draft`$/— `Complete`/' "$master"
  rewrite_file 's/^- \[ \]/- [x]/' "$master"
  rewrite_file 's/^- Status: Draft$/- Status: Complete/' "$stage"
  rewrite_file 's/^- \[ \]/- [x]/' "$stage"
  refresh_index
}

make_complete_fixture pending-completion-evidence
expect_check_failure 'Complete documents cannot use Pending evidence'

make_complete_fixture blank-completion-evidence
rewrite_file 's/| Pending |$/|   |/' "$master"
rewrite_file 's/| Pending |$/|   |/' "$stage"
expect_check_failure 'non-empty criterion, verification, and evidence'

printf 'PRD checker regression tests passed.\n'
