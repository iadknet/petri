#!/bin/sh
set -eu

require_tools=0
if [ "${1:-}" = --require-tools ]; then
  require_tools=1
  shift
fi
[ "$#" -eq 0 ] || { printf 'Usage: scripts/dependency-audit [--require-tools]\n' >&2; exit 2; }

scanner=${AQUA_ROOT_DIR:-.tools/aqua}/bin/osv-scanner
if [ ! -x "$scanner" ]; then
  if [ "$require_tools" -eq 1 ]; then
    printf 'dependency-audit: OSV-Scanner is missing; run make setup\n' >&2
    exit 1
  fi
  printf 'dependency-audit: OSV-Scanner is not installed; skipping. Run make setup for dependency scanning.\n'
  exit 0
fi

"$scanner" scan source \
  --lockfile=./Cargo.lock \
  --lockfile=./frontend/package-lock.json
