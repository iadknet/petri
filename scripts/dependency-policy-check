#!/bin/sh
set -eu

fail() {
  printf 'dependency-policy-check: %s\n' "$*" >&2
  exit 1
}

repository_root=$(pwd)

require_lockfile() {
  lockfile=$1
  [ -f "$repository_root/$lockfile" ] || fail "$lockfile must exist"

  if git -C "$repository_root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    git -C "$repository_root" ls-files --error-unmatch "$lockfile" >/dev/null 2>&1 ||
      fail "$lockfile must be committed"
  fi
}

frontend_package_manager() {
  node -e '
    const manifest = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
    if (typeof manifest.packageManager !== "string") process.exit(1);
    process.stdout.write(manifest.packageManager);
  ' "$repository_root/frontend/package.json"
}

dependabot_has_cooldown() {
  ecosystem=$1
  directory=$2

  awk -v ecosystem="$ecosystem" -v directory="$directory" '
    function finish_entry() {
      if (active && configured_directory == directory && cooldown_days == 7) found = 1
    }
    /^[[:space:]]*-[[:space:]]*package-ecosystem:[[:space:]]*/ {
      finish_entry()
      value = $0
      sub(/^[[:space:]]*-[[:space:]]*package-ecosystem:[[:space:]]*/, "", value)
      sub(/[[:space:]]*(#.*)?$/, "", value)
      gsub(/^"|"$/, "", value)
      active = value == ecosystem
      configured_directory = ""
      in_cooldown = 0
      cooldown_days = 0
      next
    }
    active && /^[[:space:]]*directory:[[:space:]]*/ {
      value = $0
      sub(/^[[:space:]]*directory:[[:space:]]*/, "", value)
      sub(/[[:space:]]*(#.*)?$/, "", value)
      gsub(/^"|"$/, "", value)
      configured_directory = value
      next
    }
    active && /^    cooldown:[[:space:]]*(#.*)?$/ {
      in_cooldown = 1
      next
    }
    active && /^    [A-Za-z-]+:/ { in_cooldown = 0 }
    active && in_cooldown && /^      default-days:[[:space:]]*/ {
      value = $0
      sub(/^      default-days:[[:space:]]*/, "", value)
      sub(/[[:space:]]*(#.*)?$/, "", value)
      cooldown_days = value
    }
    END { finish_entry(); exit found ? 0 : 1 }
  ' "$repository_root/.github/dependabot.yml"
}

require_lockfile Cargo.lock
require_lockfile frontend/package-lock.json
[ -f "$repository_root/frontend/package.json" ] || fail 'frontend/package.json must exist'
[ -f "$repository_root/.github/dependabot.yml" ] || fail '.github/dependabot.yml must exist'

package_manager=$(frontend_package_manager) || fail 'frontend/package.json requires a valid packageManager field'
printf '%s\n' "$package_manager" |
  grep -Eq '^npm@(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$' ||
  fail 'frontend packageManager must be an exact npm semantic version'

expected_npm_version=${package_manager#npm@}
command -v npm >/dev/null 2>&1 || fail "npm $expected_npm_version is required"
actual_npm_version=$(npm --version 2>/dev/null) || fail 'could not read the installed npm version'
[ "$actual_npm_version" = "$expected_npm_version" ] ||
  fail "packageManager $package_manager does not match installed npm version $actual_npm_version"

minimum_age=$(cd "$repository_root/frontend" && npm config get min-release-age --location=project 2>/dev/null) ||
  fail 'could not read frontend npm min-release-age'
[ "$minimum_age" = 7 ] || fail "frontend npm min-release-age must be 7, found $minimum_age"

for entry in 'github-actions:/' 'cargo:/' 'npm:/frontend'; do
  ecosystem=${entry%%:*}
  directory=${entry#*:}
  dependabot_has_cooldown "$ecosystem" "$directory" ||
    fail "Dependabot $ecosystem entry for $directory must set cooldown default-days: 7"
done

printf 'Dependency policy validation passed.\n'
