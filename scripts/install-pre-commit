#!/bin/sh
set -eu

version=4.5.1
# Install into a shared global tool root so every checkout and git worktree
# reuses one install. Overridable via PETRI_TOOL_ROOT; CI runners are ephemeral,
# so the default global root stays hermetic per job.
: "${PETRI_TOOL_ROOT:=${XDG_DATA_HOME:-$HOME/.local/share}/petri-tools}"
tool_root=$PETRI_TOOL_ROOT/uv-tools
bin_root=$PETRI_TOOL_ROOT/bin
target=$bin_root/pre-commit

if [ -x "$target" ] && "$target" --version 2>/dev/null | grep -Fq "pre-commit $version"; then
  printf 'pre-commit %s is already installed.\n' "$version"
else
  mkdir -p "$tool_root" "$bin_root"
UV_TOOL_DIR=$tool_root UV_TOOL_BIN_DIR=$bin_root \
    uv tool install "pre-commit==$version" --python 3.12 --managed-python --no-progress --exclude-newer '7 days'
fi

if [ "$(git config --local --get core.hooksPath 2>/dev/null || :)" = .githooks ]; then
  git config --local --unset-all core.hooksPath
fi
"$target" install --install-hooks
