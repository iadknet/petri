#!/bin/sh
set -eu

repository_root=.
while [ "$#" -gt 0 ]; do
  case $1 in
    --root)
      [ "$#" -ge 2 ] || { printf 'residual-cruft-check: --root requires a path\n' >&2; exit 2; }
      repository_root=$2
      shift 2
      ;;
    *) printf 'Usage: scripts/residual-cruft-check [--root <repository>]\n' >&2; exit 2 ;;
  esac
done

cd "$repository_root"
pattern='project-workflow|prd-(create|review|implement)|docs/prds/active|docs/prds/templates|scripts/prd-[[:alnum:]_.-]+|Review Count:|review-count|Execution Mode: (Lean|Deep)|(^|[^[:alnum:]_])(Lean|Deep)[[:space:]]+mode([^[:alnum:]_]|$)|Deep Mode Authorization|readiness review|model choice|review recursion|severity policy|feature-[1-7]|docs/(features|plans|superpowers)|master_plan\.md|(review_log|implementation_log)\.md|superpowers:|SkillSpector|check-(architecture|doc|plan)-harness|check_cargo_policy'

retired_paths=$(find . -type d \( -name .git -o -name .tools -o -name node_modules \) -prune -o \( \
  -path './.agents/skills/project-workflow' -o \
  -path './.agents/skills/prd-create' -o \
  -path './.agents/skills/prd-review' -o \
  -path './.agents/skills/prd-implement' -o \
  -path './.claude/skills/project-workflow' -o \
  -path './.claude/skills/prd-create' -o \
  -path './.claude/skills/prd-review' -o \
  -path './.claude/skills/prd-implement' -o \
  -path './docs/prds/active' -o \
  -path './docs/prds/templates' -o \
  -path './scripts/prd-*' \
\) -print)
[ -z "$retired_paths" ] || {
  printf 'residual-cruft-check: retired workflow path found:\n%s\n' "$retired_paths" >&2
  exit 1
}

matches=$(find . -type d \( -name .git -o -name .tools -o -name node_modules \) -prune -o -type f \
  ! -path './docs/prds/archive/*' ! -path './docs/archive/*' \
  ! -path './scripts/residual-cruft-check' ! -path './scripts/residual-cruft-check-test' \
  -exec grep -HnEi "$pattern" {} + 2>/dev/null || true)
[ -z "$matches" ] || { printf 'residual-cruft-check: retired workflow reference found:\n%s\n' "$matches" >&2; exit 1; }
printf 'Residual cruft validation passed.\n'
