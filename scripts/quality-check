#!/bin/sh
set -eu

require_tools=0
if [ "${1:-}" = --require-tools ]; then
  require_tools=1
  shift
fi
[ "$#" -eq 0 ] || { printf 'Usage: scripts/quality-check [--require-tools]\n' >&2; exit 2; }

if git rev-parse --git-dir >/dev/null 2>&1; then
  git diff --check
  git diff --cached --check
fi

actionlint=${AQUA_ROOT_DIR:-.tools/aqua}/bin/actionlint
shellcheck=${AQUA_ROOT_DIR:-.tools/aqua}/bin/shellcheck
if [ ! -x "$actionlint" ] || [ ! -x "$shellcheck" ]; then
  if [ "$require_tools" -eq 1 ]; then
    printf 'quality-check: pinned quality tools are missing; run make setup\n' >&2
    exit 1
  fi
  printf 'quality-check: pinned tools are not installed; using reduced checks. Run make setup for ShellCheck and actionlint.\n'
  exit 0
fi

find scripts -type f | while IFS= read -r script; do
  case "$script" in
    *.mjs) continue ;;
  esac
  case "$(head -n 1 "$script")" in
    '#!'*node*|'#!'*python*) continue ;;
    '#!'*bash*)
      bash -n "$script"
      shellcheck --shell=bash --external-sources "$script"
      ;;
    *)
      sh -n "$script"
      shellcheck --shell=sh --external-sources "$script"
      ;;
  esac
done
actionlint -shellcheck="$shellcheck"
printf 'Repository quality validation passed.\n'
