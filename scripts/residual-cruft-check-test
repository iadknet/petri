#!/bin/sh
set -eu

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
checker=$script_dir/residual-cruft-check
test_root=$(mktemp -d "${TMPDIR:-/tmp}/petri-residual-cruft-test.XXXXXX")
trap 'rm -rf "$test_root"' EXIT HUP INT TERM

fail() {
  printf 'residual-cruft-check-test: %s\n' "$*" >&2
  exit 1
}

reset_fixture() {
  rm -rf "$test_root"/docs "$test_root"/scripts "$test_root"/notes "$test_root"/.agents "$test_root"/.claude
  mkdir -p "$test_root"
}

expect_pass() {
  output=$($checker --root "$test_root" 2>&1) || { printf '%s\n' "$output" >&2; fail 'fixture unexpectedly failed'; }
}

expect_failure() {
  expected=$1
  if output=$($checker --root "$test_root" 2>&1); then
    fail 'fixture unexpectedly passed'
  fi
  printf '%s\n' "$output" | grep -F "$expected" >/dev/null || {
    printf '%s\n' "$output" >&2
    fail "missing expected diagnostic: $expected"
  }
}

reset_fixture
mkdir -p "$test_root/docs/prds/archive" "$test_root/docs/archive"
printf '%s\n' 'project-workflow prd-create Review Count: Execution Mode: Lean superpowers: feature-1' >"$test_root/docs/prds/archive/old.md"
printf '%s\n' 'docs/prds/active docs/prds/templates scripts/prd-check Deep Mode Authorization readiness review model choice severity policy' >"$test_root/docs/archive/old.md"
expect_pass

reset_fixture
mkdir -p "$test_root/notes"
printf '%s\n' 'project-workflow prd-create prd-review prd-implement docs/prds/active docs/prds/templates scripts/prd-check Review Count: review-count Execution Mode: Lean Deep Mode Authorization readiness review model choice severity policy' >"$test_root/notes/live.md"
expect_failure 'project-workflow'

reset_fixture
mkdir -p "$test_root/notes"
printf '%s\n' 'feature-1 docs/features docs/plans docs/superpowers master_plan.md review_log.md implementation_log.md superpowers: SkillSpector check-architecture-harness check-doc-harness check-plan-harness check_cargo_policy' >"$test_root/notes/legacy.md"
expect_failure 'feature-1'

reset_fixture
mkdir -p "$test_root/scripts"
printf '%s\n' 'project-workflow prd-create feature-1 Review Count: check_cargo_policy' >"$test_root/scripts/residual-cruft-check"
printf '%s\n' 'project-workflow prd-create feature-1 Review Count: check_cargo_policy' >"$test_root/scripts/residual-cruft-check-test"
expect_pass

reset_fixture
mkdir -p "$test_root/notes"
printf '%s\n' 'project-workflow' >"$test_root/notes/file with spaces.md"
expect_failure 'file with spaces.md'

for retired_path in \
  .agents/skills/project-workflow \
  .agents/skills/prd-create \
  .agents/skills/prd-review \
  .agents/skills/prd-implement \
  .claude/skills/project-workflow \
  .claude/skills/prd-create \
  .claude/skills/prd-review \
  .claude/skills/prd-implement \
  docs/prds/active \
  docs/prds/templates
do
  reset_fixture
  case $retired_path in
    .agents/skills/*|docs/prds/*)
      mkdir -p "$test_root/$retired_path"
      printf '%s\n' 'benign body' >"$test_root/$retired_path/benign.md"
      ;;
    *)
      mkdir -p "$test_root/$(dirname "$retired_path")"
      printf '%s\n' 'benign body' >"$test_root/$retired_path"
      ;;
  esac
  expect_failure "./$retired_path"
done

for retired_script in prd-archive prd-check prd-check-test prd-index prd-lib.sh prd-new
do
  reset_fixture
  mkdir -p "$test_root/scripts"
  printf '%s\n' 'benign body' >"$test_root/scripts/$retired_script"
  expect_failure "./scripts/$retired_script"
done

reset_fixture
mkdir -p "$test_root/.claude/skills" "$test_root/notes" "$test_root/docs/prds/archive"
printf '%s\n' 'benign body' >"$test_root/notes/target"
ln -s '../../notes/target' "$test_root/.claude/skills/project-workflow"
printf '%s\n' 'project-workflow' >"$test_root/docs/prds/archive/history.md"
ln -s '../docs/prds/archive/history.md' "$test_root/notes/archive-link.md"
expect_failure './.claude/skills/project-workflow'

printf 'Residual cruft checker regression tests passed.\n'
