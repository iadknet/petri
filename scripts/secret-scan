#!/bin/sh
set -eu

[ "$#" -eq 1 ] || { printf 'Usage: scripts/secret-scan <staged|history>\n' >&2; exit 2; }
scanner=.tools/aqua/bin/gitleaks
[ -x "$scanner" ] || { printf 'secret-scan: Gitleaks is not installed; run make setup\n' >&2; exit 1; }
git rev-parse --git-dir >/dev/null 2>&1 || { printf 'secret-scan: not inside a Git repository\n' >&2; exit 1; }

case $1 in
  staged) exec scripts/aqua exec gitleaks git --staged --redact --no-banner . ;;
  history) exec scripts/aqua exec gitleaks git --redact --no-banner . ;;
  *) printf 'Usage: scripts/secret-scan <staged|history>\n' >&2; exit 2 ;;
esac
