#!/bin/sh
# Retire local telemetry older than a cutoff (T21.F01).
#
# Usage: scripts/telemetry-cleanup CUTOFF [--proceed]
#   CUTOFF     YYYY-MM-DD (00:00 UTC) or an RFC3339 timestamp, in the past;
#              everything before it is retired.
#   --proceed  delete; without it, print each store's disk use, the deletion
#              interval and the exact targets, and delete nothing.
#
# Uses only the pinned image, through `docker compose exec` and `docker
# compose run`, against a running stack (`make telemetry-up`).
#
# Environment:
#   PETRI_TELEMETRY_PROJECT  Compose project (petri-telemetry) and
#   PETRI_TELEMETRY_VOLUME   its volume; scripts/telemetry-verify points both
#                            at its scratch stack.
set -eu

usage() {
  printf 'Usage: scripts/telemetry-cleanup CUTOFF [--proceed]\n' >&2
  printf '  CUTOFF: YYYY-MM-DD (00:00 UTC) or RFC3339, in the past\n' >&2
  exit 2
}

[ "$#" -ge 1 ] && [ "$#" -le 2 ] || usage
cutoff_arg=$1
proceed=0
if [ "$#" -eq 2 ]; then
  [ "$2" = --proceed ] || usage
  proceed=1
fi

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
aqua_root=${AQUA_ROOT_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/aquaproj-aqua}
export AQUA_POLICY_CONFIG="${AQUA_POLICY_CONFIG:-$root/aqua-policy.yaml}"

# Prints `<RFC3339 UTC> <epoch ms>` for a valid cutoff in the past and refuses
# anything else before any store is touched.
# shellcheck disable=SC2016 # JavaScript source.
parsed=$("$aqua_root/bin/node" -e '
  const arg = process.argv[1];
  const refuse = (why) => {
    process.stderr.write(`telemetry-cleanup: ${why}: ${arg}\n`);
    process.exit(2);
  };
  const m = /^(\d{4})-(\d{2})-(\d{2})(?:[Tt](\d{2}):(\d{2}):(\d{2})(\.\d+)?([Zz]|[+-]\d{2}:\d{2}))?$/.exec(arg);
  if (!m) refuse("CUTOFF is neither YYYY-MM-DD nor RFC3339");
  const [y, mo, d] = [m[1], m[2], m[3]].map(Number);
  const day = new Date(Date.UTC(y, mo - 1, d));
  if (day.getUTCFullYear() !== y || day.getUTCMonth() !== mo - 1 || day.getUTCDate() !== d) {
    refuse("no such date");
  }
  if (m[4] !== undefined && (Number(m[4]) > 23 || Number(m[5]) > 59 || Number(m[6]) > 59)) {
    refuse("no such time");
  }
  const ms = m[4] === undefined ? day.getTime() : Date.parse(arg.toUpperCase());
  if (Number.isNaN(ms)) refuse("unreadable timestamp");
  if (ms >= Date.now()) refuse("CUTOFF must be in the past");
  console.log(new Date(ms).toISOString().replace(".000Z", "Z"), ms);
' "$cutoff_arg") || exit 2
cutoff=${parsed% *}
cutoff_ms=${parsed#* }

project=${PETRI_TELEMETRY_PROJECT:-petri-telemetry}

compose() {
  docker compose -p "$project" -f "$root/telemetry/compose.yaml" "$@"
}

in_stack() {
  compose exec -T lgtm "$@"
}

if [ -z "$(compose ps -q --status running lgtm 2>/dev/null)" ]; then
  printf 'telemetry-cleanup: the %s stack is not running; start it with make telemetry-up\n' "$project" >&2
  exit 1
fi

# A store API call inside the container; a failed call (with the store's
# message) stops the script.
api() {
  if ! body=$(in_stack curl -sS --fail-with-body "$@"); then
    printf 'telemetry-cleanup: %s\n' "$body" >&2
    return 1
  fi
  printf '%s\n' "$body"
}

prometheus=http://127.0.0.1:9090
loki=http://127.0.0.1:3100
tempo=http://127.0.0.1:3200
series_match='{__name__=~".+"}'
stream_match='{service_name=~".+"}'
# Loki needs an explicit start; the stack disables its query-length limit.
loki_start=2000-01-01T00:00:00Z

# One JSON object per line from a `"data":[{...},{...}]` or bare `[{...}]`
# response.
split_data() {
  awk '{
    sub(/^.*"data":\[/, ""); sub(/^\[/, ""); sub(/\][^]]*$/, "")
    n = split($0, parts, /\},\{/)
    for (i = 1; i <= n; i++) {
      part = parts[i]
      if (part == "") continue
      if (substr(part, 1, 1) != "{") part = "{" part
      if (substr(part, length(part), 1) != "}") part = part "}"
      print part
    }
  }'
}

# Tempo blocks as `class dir start end bytes`, class being delete (ends before
# the cutoff), keep (starts at or after it) or straddle (kept whole); times are
# compared in milliseconds with the image's GNU date. A block marked
# meta.compacted.json is already merged into another and Tempo retires it, so
# it is never a target.
tempo_blocks() {
  # shellcheck disable=SC2016 # expands inside the container.
  in_stack sh -c '
    cutoff=$1
    for meta in /data/tempo/blocks/*/*/meta.json; do
      dir=${meta%/meta.json}
      [ -f "$meta" ] && [ ! -f "$dir/meta.compacted.json" ] || continue
      json=$(cat "$meta")
      start=$(printf "%s" "$json" | sed -n "s/.*\"startTime\":\"\([^\"]*\)\".*/\1/p")
      end=$(printf "%s" "$json" | sed -n "s/.*\"endTime\":\"\([^\"]*\)\".*/\1/p")
      bytes=$(du -sb "$dir" | cut -f1)
      start_ms=$(date -u -d "$start" +%s%3N)
      end_ms=$(date -u -d "$end" +%s%3N)
      if [ "$end_ms" -lt "$cutoff" ]; then
        class=delete
      elif [ "$start_ms" -ge "$cutoff" ]; then
        class=keep
      else
        class=straddle
      fi
      printf "%s %s %s %s %s\n" "$class" "$dir" "$start" "$end" "$bytes"
    done
  ' sh "$cutoff_ms"
}

printf 'Disk use (KiB):\n'
in_stack du -s /data/prometheus /data/tempo /data/loki
printf '\nDeletion interval: everything before %s\n' "$cutoff"

prom_raw=$(api -G "$prometheus/api/v1/series" \
  --data-urlencode "match[]=$series_match" --data-urlencode "end=$cutoff")
prom_series=$(printf '%s\n' "$prom_raw" | split_data)
prom_count=$(printf '%s' "$prom_series" | grep -c . || true)
printf '\nPrometheus: %s series with samples before the cutoff\n' "$prom_count"
[ -z "$prom_series" ] || printf '%s\n' "$prom_series"

loki_raw=$(api -G "$loki/loki/api/v1/series" \
  --data-urlencode "match[]=$stream_match" --data-urlencode "start=$loki_start" \
  --data-urlencode "end=$cutoff")
loki_streams=$(printf '%s\n' "$loki_raw" | split_data)
loki_count=$(printf '%s' "$loki_streams" | grep -c . || true)
printf '\nLoki: %s streams with entries before the cutoff\n' "$loki_count"
[ -z "$loki_streams" ] || printf '%s\n' "$loki_streams"

blocks=$(tempo_blocks)
# The backend worker merges blocks within one compaction window, so a kept
# straddling block spans at most one window.
window=$(api "$tempo/status/config" | "$root/scripts/telemetry-yaml-paths" |
  awk '$1 == "backend_scheduler.provider.compaction.compaction.compaction_window" { print $2 }')
printf '\nTempo: blocks ending before the cutoff (removed), start end bytes:\n'
printf '%s\n' "$blocks" | awk '$1 == "delete" { print "  " $2, $3, $4, $5 }'
printf 'Tempo: blocks straddling the cutoff (kept whole; each spans at most one compaction window, %s in force):\n' "${window:-unknown}"
printf '%s\n' "$blocks" | awk '$1 == "straddle" { print "  " $2, $3, $4, $5 }'

if [ "$proceed" -eq 0 ]; then
  printf '\nPreview only; rerun with --proceed (make telemetry-clean CUTOFF=%s PROCEED=1) to delete.\n' "$cutoff_arg"
  exit 0
fi

printf '\nPrometheus: deleting series samples before the cutoff\n'
api -X POST -G "$prometheus/api/v1/admin/tsdb/delete_series" \
  --data-urlencode "match[]=$series_match" --data-urlencode "end=$cutoff"
api -X POST "$prometheus/api/v1/admin/tsdb/clean_tombstones"

printf 'Loki: requesting deletion before the cutoff\n'
api -X POST -G "$loki/loki/api/v1/delete" \
  --data-urlencode "query=$stream_match" --data-urlencode "start=$loki_start" \
  --data-urlencode "end=$cutoff"
printf 'Loki delete requests (status endpoint %s/loki/api/v1/delete):\n' "$loki"
# The new request is listed a few seconds after it is accepted.
waited=0
until requests=$(api "$loki/loki/api/v1/delete") &&
  case "$requests" in *"\"end_time\":${cutoff_ms%???}"[,.]*) true ;; *) false ;; esac; do
  waited=$((waited + 1))
  [ "$waited" -lt 30 ] || break
  sleep 1
done
printf '%s\n' "$requests" | split_data
printf 'Loki applies the deletion after its cancel period and compaction interval.\n'

targets=$(printf '%s\n' "$blocks" | awk '$1 == "delete" { print $2 }')
if [ -n "$targets" ]; then
  printf 'Tempo: stopping the stack to remove %s block(s)\n' "$(printf '%s\n' "$targets" | grep -c .)"
  compose stop lgtm
  # shellcheck disable=SC2086 # block directories contain no whitespace.
  compose run --rm --no-deps -T --entrypoint rm lgtm -rf $targets
  compose start lgtm
else
  printf 'Tempo: no block ends before the cutoff\n'
fi
printf 'Done.\n'
