#!/bin/sh
# Docker-free tests of scripts/telemetry-cleanup's argument handling: a stub
# `docker` on PATH records every call and answers as a running, empty stack.
set -eu

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
cleanup=$script_dir/telemetry-cleanup
test_root=$(mktemp -d "${TMPDIR:-/tmp}/petri-telemetry-cleanup-test.XXXXXX")
trap 'rm -rf "$test_root"' 0
trap 'exit 130' INT
trap 'exit 143' HUP TERM
export CLEANUP_TEST_FIXTURE="$test_root"
mkdir "$test_root/bin"

cat >"$test_root/bin/docker" <<'STUB'
#!/bin/sh
printf '%s\n' "$*" >>"$CLEANUP_TEST_FIXTURE/docker-calls"
case "$*" in
  *' ps -q '*) printf 'stub-container\n' ;;
  */status/config*) printf 'backend_scheduler:\n    provider:\n        compaction:\n            compaction:\n                compaction_window: 1h0m0s\nbackend_worker:\n    compaction:\n        compaction_window: 9m0s\n' ;;
  *' curl '*) printf '{"status":"success","data":[]}\n' ;;
  *' du -s '*) printf '0\t/data/prometheus\n' ;;
esac
STUB
chmod +x "$test_root/bin/docker"

fail() { printf 'telemetry-cleanup-test: %s\n' "$*" >&2; exit 1; }
run_cleanup() {
  rm -f "$test_root/docker-calls"
  status=0
  PATH="$test_root/bin:$PATH" sh "$cleanup" "$@" >"$test_root/output" 2>&1 || status=$?
}
expect_refused() {
  run_cleanup "$@"
  [ "$status" -eq 2 ] || { cat "$test_root/output" >&2; fail "accepted $* (status $status)"; }
  [ ! -f "$test_root/docker-calls" ] || fail "touched docker before refusing $*"
}
expect_interval() {
  cutoff=$1
  expected=$2
  run_cleanup "$cutoff"
  [ "$status" -eq 0 ] || { cat "$test_root/output" >&2; fail "refused $cutoff (status $status)"; }
  grep -q "^Deletion interval: everything before $expected\$" "$test_root/output" ||
    { cat "$test_root/output" >&2; fail "$cutoff did not read as $expected"; }
  if grep -q 'delete_series\|/loki/api/v1/delete\|--entrypoint rm' "$test_root/docker-calls"; then
    fail "preview of $cutoff deleted"
  fi
}

# Both cutoff forms, normalized to UTC.
expect_interval 2020-01-02 2020-01-02T00:00:00Z
expect_interval 2020-01-02T03:04:05Z 2020-01-02T03:04:05Z
expect_interval 2020-01-02T03:04:05.250Z 2020-01-02T03:04:05.250Z
expect_interval 2020-01-02T03:04:05+02:00 2020-01-02T01:04:05Z
grep -q 'start=2000-01-01T00:00:00Z' "$test_root/docker-calls" || fail 'Loki series preview lacks its start'
# The preview names the scheduler's compaction window, the straddling-block bound.
grep -q '^Tempo: blocks straddling the cutoff (kept whole; each spans at most one compaction window, 1h0m0s in force)' "$test_root/output" ||
  { cat "$test_root/output" >&2; fail 'preview lacks the compaction window in force'; }

# Cutoffs in the future or at a moment that is not yet past are refused.
expect_refused 2999-01-01
expect_refused 2999-01-01T00:00:00Z
future=$(($(date -u +%Y) + 1))-01-01
expect_refused "$future"

# Malformed or impossible cutoffs are refused.
expect_refused 2026-02-31
expect_refused 2026-13-01
expect_refused 2020-01-02T24:00:00Z
expect_refused 2020-01-02T03:04:05
expect_refused 2020-1-2
expect_refused yesterday
expect_refused ''
expect_refused 2020-01-02 --force

# Usage errors.
run_cleanup
[ "$status" -eq 2 ] || fail "no argument accepted (status $status)"
run_cleanup 2020-01-02 --proceed extra
[ "$status" -eq 2 ] || fail "extra argument accepted (status $status)"

# `make telemetry-clean` passes --proceed only for PROCEED=1.
expect_make_proceed() {
  proceed=$1
  expected=$2
  line=$(make -s -n -C "$script_dir/.." telemetry-clean CUTOFF=2020-01-02 PROCEED="$proceed" | grep 'scripts/telemetry-cleanup ') ||
    fail "make telemetry-clean PROCEED=$proceed runs no cleanup"
  case $line in
    *--proceed*) found=yes ;;
    *) found=no ;;
  esac
  [ "$found" = "$expected" ] || fail "make telemetry-clean PROCEED=$proceed: --proceed $found, expected $expected"
}
expect_make_proceed 1 yes
expect_make_proceed 0 no
expect_make_proceed yes no
expect_make_proceed '0 1' no
expect_make_proceed '1 1' no
expect_make_proceed '' no

printf 'telemetry-cleanup-test: ok\n'
