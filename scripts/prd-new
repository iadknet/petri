#!/bin/sh
set -eu

usage() {
  printf 'Usage: scripts/prd-new <kebab-slug> <stage-slug> [stage-slug ...]\n' >&2
}

[ "$#" -ge 2 ] || { usage; exit 2; }
prd_slug=$1
shift
[ "$#" -le 99 ] || { printf 'prd-new: at most 99 stages are supported\n' >&2; exit 1; }
case $prd_slug in ''|*[!a-z0-9-]*|-*|*-|*--*) printf 'prd-new: invalid kebab-case PRD slug: %s\n' "$prd_slug" >&2; exit 1 ;; esac

stage_slugs_seen=' '
for stage_slug in "$@"; do
  case $stage_slug in ''|*[!a-z0-9-]*|-*|*-|*--*) printf 'prd-new: invalid kebab-case stage slug: %s\n' "$stage_slug" >&2; exit 1 ;; esac
  case $stage_slugs_seen in
    *" $stage_slug "*) printf 'prd-new: duplicate stage slug: %s\n' "$stage_slug" >&2; exit 1 ;;
  esac
  stage_slugs_seen="$stage_slugs_seen$stage_slug "
done

prd_dir=docs/prds/active/$prd_slug
[ ! -e "$prd_dir" ] || { printf 'prd-new: PRD set already exists: %s\n' "$prd_dir" >&2; exit 1; }

title_from_slug() {
  printf '%s\n' "$1" | awk -F- '{ for (i=1; i<=NF; i++) { $i=toupper(substr($i,1,1)) substr($i,2) } OFS=" "; print }'
}

mkdir -p "$prd_dir"
prd_title=$(title_from_slug "$prd_slug")
created=$(date +%F)

{
  printf '# %s — Master PRD\n\n' "$prd_title"
    printf '%s\n' '- Status: Draft' '- Owner: Unassigned' "- Created: $created" '- Review Status: DRAFT' '- Review Count: 0'
  cat <<'EOF'

## Goal

State the user or project outcome.

## Scope

- Define what this PRD set owns.

## Non-Goals

- Define nearby work this PRD set does not own.

## Inputs and Existing-Code Interactions

Describe repository evidence, dependencies, and affected existing code.

## Boundaries and Abstraction Layers

Define cross-stage boundaries and which abstraction level owns each decision.

## Separation of Concerns and Decomposition

Explain why these stages are independently coherent and dependency ordered.

## Tech Debt and Spaghetti-Code Implications

None identified. Revise this after concrete design analysis.

## Documentation Impact and Synchronization

Summarize durable documentation affected across stages. If none is affected,
record a concrete no-change rationale.

## Stage Order and Links

EOF
  stage_number=1
  for stage_slug in "$@"; do
    stage_padded=$(printf '%02d' "$stage_number")
    stage_title=$(title_from_slug "$stage_slug")
    # shellcheck disable=SC2016 # Backticks are literal Markdown.
    printf '%s. [Stage %s — %s](stage-%s-%s.md) — `Draft`\n' "$stage_number" "$stage_padded" "$stage_title" "$stage_padded" "$stage_slug"
    stage_number=$((stage_number + 1))
  done
  cat <<'EOF'

Summarize stage ordering and contracts here without duplicating stage tasks.

## Cross-Stage Decisions

- Record decisions shared by multiple stages.

## Implementation or Decision Tasks

- [ ] Keep stage links and status summaries current.

## Verification and Observable Success Criteria

- [ ] Every stage's declared verification has passed.
- [ ] Affected durable documentation is created, updated, or synchronized, or a no-change rationale is recorded.
- [ ] The final-code review gate has passed.

## Current Status

Draft. Complete the content, then request readiness review.
EOF
} >"$prd_dir/master-prd.md"

stage_number=1
previous_stage=None
for stage_slug in "$@"; do
  stage_padded=$(printf '%02d' "$stage_number")
  stage_title=$(title_from_slug "$stage_slug")
  stage_file=$prd_dir/stage-$stage_padded-$stage_slug.md
  {
    printf '# Stage %s — %s\n\n' "$stage_padded" "$stage_title"
    printf '%s\n' '- Status: Draft' "- Depends on: $previous_stage" '- Master: [Master PRD](master-prd.md)'
    cat <<'EOF'

## Goal

State this stage's independently observable outcome.

## Scope

- Define work owned by this stage.

## Non-Goals

- Define work deferred to another stage or PRD.

## Inputs and Existing-Code Interactions

Describe inputs, dependencies, and concrete interactions with existing code.

## Boundaries and Abstraction Layers

State interfaces changed and the abstraction level for each decision.

## Separation of Concerns and Decomposition

Explain why this stage is cohesive and where further splitting is or is not useful.

## Tech Debt and Spaghetti-Code Implications

None identified. Revise this after concrete design analysis.

## Documentation Impact and Synchronization

List durable user, operator, developer, architecture, API, or generated-reference
documentation to create, update, or synchronize. If none is affected, write
`No documentation changes required: <rationale>`.

## Implementation or Decision Tasks

- [ ] Complete a concrete task.

## Verification and Observable Success Criteria

- [ ] Run a concrete check and record the observable result.
- [ ] Affected durable documentation is created, updated, or synchronized, or a no-change rationale is recorded.

## Current Status

Draft. Complete the content, then request readiness review.
EOF
  } >"$stage_file"
  previous_stage=$stage_file
  previous_stage=$(basename "$previous_stage")
  stage_number=$((stage_number + 1))
done

scripts/prd-index
scripts/prd-check
printf 'Created %s with %s stage(s).\n' "$prd_dir" "$#"
